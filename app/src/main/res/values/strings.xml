    <string name="permission_title">Access to your home network</string>
    <string name="permission_body">Hausmusik talks to your speakers directly, without a Sonos account or cloud. For that, Android asks for access to devices in your home network; the dialog calls them nearby devices. Nothing leaves your home network.</string>
